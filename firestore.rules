rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /posts/{postId} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /videos/{videoId} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /files/{fileId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow read, update, delete: if signedIn() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);

      match /{candidates}/{candidateId} {
        allow read, write: if signedIn();
      }
    }
  }
}
